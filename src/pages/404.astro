---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="404 — Not found">
  <section class="mx-auto max-w-3xl px-6 pt-32 pb-40 text-center">
    <p class="text-sm uppercase tracking-[0.4em] text-white/50 mb-8">Error</p>
    <h1 class="text-7xl md:text-9xl font-extrabold tracking-tight">404</h1>
    <p class="mt-6 text-lg text-white/70">This line doesn't exist.</p>
    <a href="/" class="mt-10 inline-block px-8 py-4 rounded-full border border-white/20 text-sm hover:bg-white/5 transition-colors">Return home</a>
  </section>
</BaseLayout>
