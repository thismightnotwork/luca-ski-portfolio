---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="404 — Page not found">
  <section class="mx-auto max-w-3xl px-6 py-32 text-center">
    <h1 class="text-6xl md:text-8xl font-extrabold tracking-tight">404</h1>
    <p class="mt-4 text-white/80">This line doesn't exist.</p>
    <a href="/" class="mt-8 inline-block px-6 py-3 rounded-full border border-white/30 text-sm hover:bg-white/5">Back to home</a>
  </section>
</BaseLayout>
