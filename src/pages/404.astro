---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="404 — Page Not Found">
  <main class="min-h-screen flex items-center justify-center px-6">
    <div class="text-center">
      <p class="text-xs font-mono uppercase tracking-[0.18em] text-white/40 mb-6">Error</p>
      <h1 class="font-[family-name:var(--font-display)] text-8xl lg:text-[12rem] mb-6">404</h1>
      <p class="text-xl text-white/60 mb-10">This line doesn't exist.</p>
      <a href="/" class="inline-flex px-9 py-4 text-sm font-bold tracking-[0.12em] uppercase border border-white/20 hover:border-white/60 transition-colors">Return home</a>
    </div>
  </main>
</BaseLayout>
