---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="404 - Not Found">
  <main class="min-h-screen flex items-center justify-center px-6">
    <div class="text-center">
      <div class="flex items-center justify-center gap-3 mb-8">
        <div class="flex gap-1.5">
          <span class="w-2.5 h-4 border-2 border-red-500 [clip-path:polygon(0_0,100%_25%,100%_75%,0_100%)]"></span>
          <span class="w-2.5 h-4 border-2 border-blue-500 [clip-path:polygon(0_0,100%_25%,100%_75%,0_100%)] -ml-1.5"></span>
        </div>
        <span class="text-[10px] font-mono uppercase tracking-[0.28em] text-white/40">Error</span>
      </div>
      <h1 class="font-[family-name:var(--font-display)] text-7xl md:text-9xl lg:text-[14rem] leading-none mb-6">404</h1>
      <p class="text-xl text-white/60 mb-10">This line doesn't exist.</p>
      <a href="/" class="inline-flex items-center gap-3 px-10 py-4 text-[10px] font-bold tracking-[0.24em] uppercase border border-white/20 hover:border-white/40 transition-all">Return home</a>
    </div>
  </main>
</BaseLayout>
