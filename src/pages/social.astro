---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import ProgressBar from '../components/ProgressBar.astro';
---
<BaseLayout title="Social - Luca Finnis-Bernard" description="Follow Luca Finnis-Bernard on social media.">
  <ProgressBar />
  <Navigation />
  <main id="main" class="pt-28 md:pt-36 pb-20 md:pb-24">
    <section class="relative overflow-hidden">
      <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-red-500/20 to-transparent"></div>
      <div class="mx-auto max-w-[1440px] px-6 lg:px-12 relative">
        <div class="max-w-4xl mb-16">
          <div class="flex items-center gap-3 mb-8">
            <div class="flex gap-1.5">
              <span class="w-2.5 h-4 border-2 border-red-500 [clip-path:polygon(0_0,100%_25%,100%_75%,0_100%)]"></span>
              <span class="w-2.5 h-4 border-2 border-blue-500 [clip-path:polygon(0_0,100%_25%,100%_75%,0_100%)] -ml-1.5"></span>
            </div>
            <span class="text-[10px] font-mono uppercase tracking-[0.32em] text-white/50">Social</span>
          </div>
          <h1 class="font-[family-name:var(--font-display)] uppercase leading-[0.9] mb-6 text-5xl lg:text-7xl">Follow The Journey</h1>
          <p class="text-lg text-white/70 leading-relaxed">Racing updates, training days and mountain moments.</p>
        </div>
        
        <div class="mb-16">
          <div class="flex items-center justify-between mb-8">
            <h2 class="text-2xl lg:text-3xl font-[family-name:var(--font-heading)] font-bold">Instagram</h2>
            <a href="https://instagram.com/luca.fb_ski" target="_blank" rel="noopener noreferrer" class="text-[10px] font-bold tracking-[0.24em] uppercase text-white/60 hover:text-white transition-colors">@luca.fb_ski →</a>
          </div>
          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
            <a href="https://www.instagram.com/reel/De-ZZVboXQR/" target="_blank" rel="noopener noreferrer" class="group relative border border-white/[0.12] overflow-hidden hover:border-white/40 transition-all">
              <div class="aspect-square bg-gradient-to-br from-pink-500/20 to-purple-500/20 flex items-center justify-center">
                <svg class="w-12 h-12 text-white/80 group-hover:scale-110 transition-transform" viewBox="0 0 24 24" fill="currentColor"><path d="M7 2h10a5 5 0 015 5v10a5 5 0 01-5 5H7a5 5 0 01-5-5V7a5 5 0 015-5zm0 2a3 3 0 00-3 3v10a3 3 0 003 3h10a3 3 0 003-3V7a3 3 0 00-3-3H7zm5 3a5 5 0 110 10 5 5 0 010-10zm0 2a3 3 0 100 6 3 3 0 000-6zm5.5-.25a1.25 1.25 0 110 2.5 1.25 1.25 0 010-2.5z"/></svg>
              </div>
              <div class="absolute inset-x-0 bottom-0 p-4 bg-gradient-to-t from-black/80 to-transparent">
                <p class="text-sm font-medium">View Reel</p>
              </div>
            </a>
            <a href="https://www.instagram.com/reel/DemibnZIrBN/" target="_blank" rel="noopener noreferrer" class="group relative border border-white/[0.12] overflow-hidden hover:border-white/40 transition-all">
              <div class="aspect-square bg-gradient-to-br from-pink-500/20 to-purple-500/20 flex items-center justify-center">
                <svg class="w-12 h-12 text-white/80 group-hover:scale-110 transition-transform" viewBox="0 0 24 24" fill="currentColor"><path d="M7 2h10a5 5 0 015 5v10a5 5 0 01-5 5H7a5 5 0 01-5-5V7a5 5 0 015-5zm0 2a3 3 0 00-3 3v10a3 3 0 003 3h10a3 3 0 003-3V7a3 3 0 00-3-3H7zm5 3a5 5 0 110 10 5 5 0 010-10zm0 2a3 3 0 100 6 3 3 0 000-6zm5.5-.25a1.25 1.25 0 110 2.5 1.25 1.25 0 010-2.5z"/></svg>
              </div>
              <div class="absolute inset-x-0 bottom-0 p-4 bg-gradient-to-t from-black/80 to-transparent">
                <p class="text-sm font-medium">View Reel</p>
              </div>
            </a>
            <a href="https://www.instagram.com/reel/DeY6onVo76f/" target="_blank" rel="noopener noreferrer" class="group relative border border-white/[0.12] overflow-hidden hover:border-white/40 transition-all">
              <div class="aspect-square bg-gradient-to-br from-pink-500/20 to-purple-500/20 flex items-center justify-center">
                <svg class="w-12 h-12 text-white/80 group-hover:scale-110 transition-transform" viewBox="0 0 24 24" fill="currentColor"><path d="M7 2h10a5 5 0 015 5v10a5 5 0 01-5 5H7a5 5 0 01-5-5V7a5 5 0 015-5zm0 2a3 3 0 00-3 3v10a3 3 0 003 3h10a3 3 0 003-3V7a3 3 0 00-3-3H7zm5 3a5 5 0 110 10 5 5 0 010-10zm0 2a3 3 0 100 6 3 3 0 000-6zm5.5-.25a1.25 1.25 0 110 2.5 1.25 1.25 0 010-2.5z"/></svg>
              </div>
              <div class="absolute inset-x-0 bottom-0 p-4 bg-gradient-to-t from-black/80 to-transparent">
                <p class="text-sm font-medium">View Reel</p>
              </div>
            </a>
          </div>
        </div>
        
        <div class="mb-16">
          <div class="flex items-center justify-between mb-8">
            <h2 class="text-2xl lg:text-3xl font-[family-name:var(--font-heading)] font-bold">TikTok</h2>
            <a href="https://tiktok.com/@luca.fb_ski" target="_blank" rel="noopener noreferrer" class="text-[10px] font-bold tracking-[0.24em] uppercase text-white/60 hover:text-white transition-colors">@luca.fb_ski →</a>
          </div>
          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
            <a href="https://www.tiktok.com/@luca.fb_ski/video/7682125034890071329" target="_blank" rel="noopener noreferrer" class="group relative border border-white/[0.12] overflow-hidden hover:border-white/40 transition-all">
              <div class="aspect-[9/16] bg-gradient-to-br from-cyan-500/20 to-pink-500/20 flex items-center justify-center">
                <svg class="w-12 h-12 text-white/80 group-hover:scale-110 transition-transform" viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-5.2 1.74 2.89 2.89 0 012.31-4.64 2.93 2.93 0 01.88.13V9.4a6.84 6.84 0 00-1-.05A6.33 6.33 0 005 20.1a6.34 6.34 0 0010.86-4.43v-7a8.16 8.16 0 004.77 1.52v-3.4a4.85 4.85 0 01-1-.1z"/></svg>
              </div>
              <div class="absolute inset-x-0 bottom-0 p-4 bg-gradient-to-t from-black/80 to-transparent">
                <p class="text-sm font-medium">View Video</p>
              </div>
            </a>
            <a href="https://www.tiktok.com/@luca.fb_ski/video/7687282702516620577" target="_blank" rel="noopener noreferrer" class="group relative border border-white/[0.12] overflow-hidden hover:border-white/40 transition-all">
              <div class="aspect-[9/16] bg-gradient-to-br from-cyan-500/20 to-pink-500/20 flex items-center justify-center">
                <svg class="w-12 h-12 text-white/80 group-hover:scale-110 transition-transform" viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-5.2 1.74 2.89 2.89 0 012.31-4.64 2.93 2.93 0 01.88.13V9.4a6.84 6.84 0 00-1-.05A6.33 6.33 0 005 20.1a6.34 6.34 0 0010.86-4.43v-7a8.16 8.16 0 004.77 1.52v-3.4a4.85 4.85 0 01-1-.1z"/></svg>
              </div>
              <div class="absolute inset-x-0 bottom-0 p-4 bg-gradient-to-t from-black/80 to-transparent">
                <p class="text-sm font-medium">View Video</p>
              </div>
            </a>
            <a href="https://www.tiktok.com/@luca.fb_ski/video/7694202565868719393" target="_blank" rel="noopener noreferrer" class="group relative border border-white/[0.12] overflow-hidden hover:border-white/40 transition-all">
              <div class="aspect-[9/16] bg-gradient-to-br from-cyan-500/20 to-pink-500/20 flex items-center justify-center">
                <svg class="w-12 h-12 text-white/80 group-hover:scale-110 transition-transform" viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-5.2 1.74 2.89 2.89 0 012.31-4.64 2.93 2.93 0 01.88.13V9.4a6.84 6.84 0 00-1-.05A6.33 6.33 0 005 20.1a6.34 6.34 0 0010.86-4.43v-7a8.16 8.16 0 004.77 1.52v-3.4a4.85 4.85 0 01-1-.1z"/></svg>
              </div>
              <div class="absolute inset-x-0 bottom-0 p-4 bg-gradient-to-t from-black/80 to-transparent">
                <p class="text-sm font-medium">View Video</p>
              </div>
            </a>
          </div>
        </div>
        
        <div class="grid md:grid-cols-3 gap-4">
          <a href="https://youtube.com/@luca.fb_ski" target="_blank" rel="noopener noreferrer" class="border border-white/[0.12] p-6 hover:border-white/40 transition-all group">
            <div class="flex items-center gap-3 mb-3">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M23 9.71a8.5 8.5 0 00-.91-4.13 2.92 2.92 0 00-1.72-1A78.36 78.36 0 0012 4.27a78.45 78.45 0 00-8.34.3 2.87 2.87 0 00-1.46.74c-.9.83-1 2.25-1.1 3.45a48.29 48.29 0 000 6.48 9.55 9.55 0 00.3 2 3.14 3.14 0 00.71 1.36 2.86 2.86 0 001.49.78 45.18 45.18 0 006.33.33 78.69 78.69 0 009.44-.33 2.84 2.84 0 001.49-.78 3.36 3.36 0 00.71-1.36 8.83 8.83 0 00.33-2.54c.01-1.75.06-3.5.12-5.25zM9.74 14.85V8.66l5.92 3.11c-1.66.92-3.28 1.83-5.92 3.08z"/></svg>
              <span class="font-semibold">YouTube</span>
            </div>
            <p class="text-sm text-white/40">@luca.fb_ski</p>
          </a>
          <a href="https://facebook.com/luca.fb_ski" target="_blank" rel="noopener noreferrer" class="border border-white/[0.12] p-6 hover:border-white/40 transition-all group">
            <div class="flex items-center gap-3 mb-3">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
              <span class="font-semibold">Facebook</span>
            </div>
            <p class="text-sm text-white/40">@luca.fb_ski</p>
          </a>
          <a href="https://strava.com/athletes/luca.fb_ski" target="_blank" rel="noopener noreferrer" class="border border-white/[0.12] p-6 hover:border-white/40 transition-all group">
            <div class="flex items-center gap-3 mb-3">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M15.387 17.944l-2.089-4.116h-3.065L15.387 24l5.15-10.172h-3.066m-7.008-5.599l2.836 5.598h4.172L10.463 0l-7 13.828h4.169"/></svg>
              <span class="font-semibold">Strava</span>
            </div>
            <p class="text-sm text-white/40">Athlete Profile</p>
          </a>
        </div>
      </div>
    </section>
  </main>
  <footer class="border-t border-white/[0.08] py-10">
    <div class="mx-auto max-w-[1440px] px-6 lg:px-12 flex flex-col lg:flex-row items-center justify-between gap-6">
      <p class="font-[family-name:var(--font-display)] tracking-[0.42em] uppercase">LUCA<span class="text-red-500">.</span>FB</p>
      <p class="text-sm text-white/40">© <span id="year"></span> Luca Finnis-Bernard</p>
    </div>
  </footer>
  <script is:inline>document.getElementById('year').textContent = new Date().getFullYear();</script>
</BaseLayout>
