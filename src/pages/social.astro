---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import ProgressBar from '../components/ProgressBar.astro';
import fs from 'fs';
import path from 'path';

let igStats = null;
try {
  const statsPath = path.resolve(process.cwd(), 'data/instagram-stats.json');
  if (fs.existsSync(statsPath)) {
    igStats = JSON.parse(fs.readFileSync(statsPath, 'utf8'));
  }
} catch (e) {}

const igTotalLikes = igStats?.totalLikes || igStats?.reels?.reduce((sum, r) => sum + (r.likes || 0), 0) || 0;
const igTotalViews = igStats?.totalViews || igStats?.reels?.reduce((sum, r) => sum + (r.views || 0), 0) || 0;
const ttTotalLikes = 5051 + 155 + 98;
const ttTotalViews = 183200 + 9504 + 6442;
