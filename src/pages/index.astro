---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import ProgressBar from '../components/ProgressBar.astro';
---
<BaseLayout>
  <ProgressBar />
  <Navigation />
  <main id="main" class="pt-28 md:pt-36 pb-20 md:pb-24">
    <section class="relative overflow-hidden">
      <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-white/5 to-transparent"></div>
      <div class="absolute -top-60 right-[-30%] w-[80vw] h-[80vw] rounded-full bg-gradient-to-br from-red-500/12 to-blue-500/12 blur-3xl"></div>
      <div class="mx-auto max-w-[1440px] px-6 lg:px-12 relative">
        <div class="max-w-5xl mb-12 md:mb-16">
          <div class="flex items-center gap-3 mb-6 md:mb-8">
            <div class="flex gap-1.5">
              <span class="w-2.5 h-4 border-2 border-red-500 [clip-path:polygon(0_0,100%_25%,100%_75%,0_100%)]"></span>
              <span class="w-2.5 h-4 border-2 border-blue-500 [clip-path:polygon(0_0,100%_25%,100%_75%,0_100%)] -ml-1.5"></span>
            </div>
            <span class="text-[10px] font-mono uppercase tracking-[0.28em] text-white/40">Alpine Ski Racer - BASI Level 2 Instructor</span>
          </div>
          <h1 class="font-[family-name:var(--font-display)] uppercase leading-[0.9] mb-8 md:mb-10 text-[12vw] sm:text-[9vw] lg:text-[8rem]">FIND THE<br/>EDGE.</h1>
          <p class="text-lg md:text-xl lg:text-2xl text-white/70 leading-relaxed max-w-4xl">I'm Luca Finnis-Bernard - a British U18 alpine ski racer for Hemel Ski Race Club, BASI Ski UK Level 2 instructor and Snow Shepherd Pro Deal athlete.</p>
        </div>
        <div class="grid lg:grid-cols-[1.1fr_1fr] gap-12 lg:gap-20 mb-16">
          <div class="space-y-6 text-white/70 leading-relaxed text-lg">
            <p>I race for Hemel Ski Race Club (HSRC) and teach skiing at The Snow Centre in Hemel Hempstead and Knockhatch Adventure Park. My training combines dry-slope and snow-based race preparation in the UK with mountain-racing mileage in Tignes.</p>
            <p>My focus is on precision, gate technique and line choice - applying the same principles in coaching that I use in race training. Every turn has intent.</p>
            <p>I'm on a Snow Shepherd Pro Deal, receiving 50% off Snow Shepherd products. I'm always looking for support from brands, businesses and people who want to be part of my racing journey.</p>
          </div>
          <div class="border border-white/[0.08] bg-[#080a0f] p-8 lg:p-10">
            <h2 class="text-2xl font-[family-name:var(--font-heading)] font-bold mb-8">Quick Facts</h2>
            <ul class="divide-y divide-white/10">
              <li class="flex justify-between py-4"><span class="text-white/50">Nationality</span><span class="font-semibold">Great Britain</span></li>
              <li class="flex justify-between py-4"><span class="text-white/50">Category</span><span class="font-semibold">U18</span></li>
              <li class="flex justify-between py-4"><span class="text-white/50">Disciplines</span><span class="font-semibold">Slalom &amp; Giant Slalom</span></li>
              <li class="flex justify-between py-4"><span class="text-white/50">Race Club</span><span class="font-semibold">Hemel Ski Race Club</span></li>
              <li class="flex justify-between py-4"><span class="text-white/50">Qualification</span><span class="font-semibold">BASI Ski UK Level 2</span></li>
              <li class="flex justify-between py-4"><span class="text-white/50">Support</span><span class="font-semibold">Snow Shepherd Pro Deal</span></li>
            </ul>
          </div>
        </div>
        <div class="flex flex-wrap gap-3 sm:gap-4">
          <a href="/skiing" class="relative inline-flex items-center gap-3 px-8 sm:px-10 py-3.5 sm:py-4 text-[10px] font-bold tracking-[0.24em] uppercase bg-gradient-to-r from-red-500 to-red-600 overflow-hidden group">
            <span class="relative z-10">Race results</span>
            <svg class="relative z-10 w-4 h-4 group-hover:translate-x-1 transition-transform" viewBox="0 0 16 16" fill="none"><path d="M6 3L11 8L6 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <span class="absolute inset-0 bg-gradient-to-r from-blue-500 to-red-500 -translate-x-full group-hover:translate-x-0 transition-transform duration-700"></span>
          </a>
          <a href="/journey" class="inline-flex items-center gap-3 px-8 sm:px-10 py-3.5 sm:py-4 text-[10px] font-bold tracking-[0.24em] uppercase border border-white/20 hover:border-white/40 transition-all">Journey</a>
          <a href="/gallery" class="inline-flex items-center gap-3 px-8 sm:px-10 py-3.5 sm:py-4 text-[10px] font-bold tracking-[0.24em] uppercase border border-white/20 hover:border-white/40 transition-all">Gallery</a>
          <a href="/contact" class="inline-flex items-center gap-3 px-8 sm:px-10 py-3.5 sm:py-4 text-[10px] font-bold tracking-[0.24em] uppercase border border-white/20 hover:border-white/40 transition-all">Contact</a>
        </div>
      </div>
    </section>
  </main>
  <footer class="border-t border-white/[0.08] py-10">
    <div class="mx-auto max-w-[1440px] px-6 lg:px-12 flex flex-col lg:flex-row items-center justify-between gap-6">
      <p class="font-[family-name:var(--font-display)] tracking-[0.42em] uppercase">LUCA<span class="text-red-500">.</span>FB</p>
      <p class="text-sm text-white/40">© <span id="year"></span> Luca Finnis-Bernard</p>
    </div>
  </footer>
  <script is:inline>document.getElementById('year').textContent = new Date().getFullYear();</script>
</BaseLayout>
