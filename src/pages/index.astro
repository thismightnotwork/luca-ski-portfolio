---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import ProgressBar from '../components/ProgressBar.astro';
---
<BaseLayout>
  <ProgressBar />
  <Navigation />
  <main id="main" class="pt-28 md:pt-36 pb-20 md:pb-24">
        <section class="relative overflow-hidden">
      <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-red-500/20 to-transparent"></div>
      <div class="absolute -top-80 right-[-40%] w-[100vw] h-[100vw] rounded-full bg-gradient-to-br from-red-500/15 via-blue-500/10 to-transparent blur-3xl"></div>
      <div class="absolute top-1/3 left-[-20%] w-[60vw] h-[60vw] rounded-full bg-gradient-to-tr from-blue-500/8 to-transparent blur-3xl"></div>
      <div class="mx-auto max-w-[1440px] px-6 lg:px-12 relative">
        <div class="max-w-5xl mb-12 md:mb-16">
          <div class="flex items-center gap-3 mb-6 md:mb-8 animate-fade-in-up">
            <div class="flex gap-1.5">
              <span class="w-2.5 h-4 border-2 border-red-500 [clip-path:polygon(0_0,100%_25%,100%_75%,0_100%)]"></span>
              <span class="w-2.5 h-4 border-2 border-blue-500 [clip-path:polygon(0_0,100%_25%,100%_75%,0_100%)] -ml-1.5"></span>
            </div>
            <span class="text-[10px] font-mono uppercase tracking-[0.32em] text-white/50">Great Britain • U18 • Hemel Ski Race Club</span>
          </div>
          <h1 class="font-[family-name:var(--font-display)] uppercase leading-[0.9] mb-8 md:mb-10 text-[12vw] sm:text-[9vw] lg:text-[8rem] animate-fade-in-up delay-100">FIND THE<br/><span class="text-transparent bg-clip-text bg-gradient-to-r from-red-500 to-blue-400">EDGE.</span></h1>
          <p class="text-lg md:text-xl lg:text-2xl text-white/70 leading-relaxed max-w-4xl mb-10 animate-fade-in-up delay-200">British U18 alpine ski racer. BASI Ski UK Level 2 instructor at The Snow Centre and Knockhatch Ski School. Snow Shepherd Pro Deal athlete.</p>
          <div class="flex flex-wrap gap-3 sm:gap-4 animate-fade-in-up delay-300">
            <a href="/skiing" class="relative inline-flex items-center gap-3 px-8 sm:px-10 py-3.5 sm:py-4 text-[10px] font-bold tracking-[0.24em] uppercase bg-gradient-to-r from-red-500 to-red-600 overflow-hidden group">
              <span class="relative z-10">Race results</span>
              <svg class="relative z-10 w-4 h-4 group-hover:translate-x-1 transition-transform" viewBox="0 0 16 16" fill="none"><path d="M6 3L11 8L6 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <span class="absolute inset-0 bg-gradient-to-r from-blue-500 to-red-500 -translate-x-full group-hover:translate-x-0 transition-transform duration-700"></span>
            </a>
            <a href="/contact" class="inline-flex items-center gap-3 px-8 sm:px-10 py-3.5 sm:py-4 text-[10px] font-bold tracking-[0.24em] uppercase border border-white/30 hover:border-white/60 hover:bg-white/5 transition-all">Get in touch</a>
          </div>
        </div>
        <div class="grid lg:grid-cols-[1.1fr_1fr] gap-12 lg:gap-20 mb-16">
          <div class="space-y-6 text-white/70 leading-relaxed text-lg">
            <p>I race for Hemel Ski Race Club (HSRC). I teach skiing at The Snow Centre in Hemel Hempstead and Knockhatch Ski School. I train at The Snow Centre and Knockhatch Ski School and get mountain-racing mileage in Tignes.</p>
            <p>My focus is on precision, gate technique and line choice - applying the same principles in coaching that I use in race training. Every turn has intent.</p>
            <p>I'm on a Snow Shepherd Pro Deal, receiving 50% off Snow Shepherd products. I'm always looking for support from brands, businesses and people who want to be part of my racing journey.</p>
          </div>
          <div class="relative border border-white/[0.12] bg-gradient-to-b from-white/[0.02] to-transparent overflow-hidden">
            <div class="absolute top-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-red-500/40 to-transparent"></div>
            <div class="p-8 lg:p-10">
              <h2 class="text-2xl font-[family-name:var(--font-heading)] font-bold mb-8">Quick Facts</h2>
              <ul class="divide-y divide-white/10">
                <li class="flex justify-between py-4"><span class="text-white/50">Nationality</span><span class="font-semibold">Great Britain</span></li>
                <li class="flex justify-between py-4"><span class="text-white/50">Category</span><span class="font-semibold">U18</span></li>
                <li class="flex justify-between py-4"><span class="text-white/50">Disciplines</span><span class="font-semibold">Slalom &amp; Giant Slalom</span></li>
                <li class="flex justify-between py-4"><span class="text-white/50">Race Club</span><span class="font-semibold">Hemel Ski Race Club</span></li>
                <li class="flex justify-between py-4"><span class="text-white/50">Qualification</span><span class="font-semibold">BASI Ski UK Level 2</span></li>
                <li class="flex justify-between py-4"><span class="text-white/50">Support</span><span class="font-semibold">Snow Shepherd Pro Deal</span></li>
              </ul>
            </div>
          </div>
        </div>
        <div class="flex flex-wrap gap-3 sm:gap-4 mb-10">
          <a href="/journey" class="inline-flex items-center gap-3 px-8 sm:px-10 py-3.5 sm:py-4 text-[10px] font-bold tracking-[0.24em] uppercase border border-white/20 hover:border-white/40 transition-all">Journey</a>
          <a href="/gallery" class="inline-flex items-center gap-3 px-8 sm:px-10 py-3.5 sm:py-4 text-[10px] font-bold tracking-[0.24em] uppercase border border-white/20 hover:border-white/40 transition-all">Gallery</a>
          <a href="/contact" class="inline-flex items-center gap-3 px-8 sm:px-10 py-3.5 sm:py-4 text-[10px] font-bold tracking-[0.24em] uppercase border border-white/20 hover:border-white/40 transition-all">Contact</a>
        </div>
        <div class="flex items-center gap-4">
          <span class="text-[10px] font-mono uppercase tracking-[0.22em] text-white/40">Follow</span>
          <div class="flex items-center gap-3">
            <a href="https://instagram.com/luca.fb_ski" target="_blank" rel="noopener noreferrer" class="w-10 h-10 flex items-center justify-center border border-white/15 hover:border-white/40 hover:bg-white/5 transition-all" aria-label="Instagram">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M7 2h10a5 5 0 015 5v10a5 5 0 01-5 5H7a5 5 0 01-5-5V7a5 5 0 015-5zm0 2a3 3 0 00-3 3v10a3 3 0 003 3h10a3 3 0 003-3V7a3 3 0 00-3-3H7zm5 3a5 5 0 110 10 5 5 0 010-10zm0 2a3 3 0 100 6 3 3 0 000-6zm5.5-.25a1.25 1.25 0 110 2.5 1.25 1.25 0 010-2.5z"/></svg>
            </a>
            <a href="https://tiktok.com/@luca.fb_ski" target="_blank" rel="noopener noreferrer" class="w-10 h-10 flex items-center justify-center border border-white/15 hover:border-white/40 hover:bg-white/5 transition-all" aria-label="TikTok">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-5.2 1.74 2.89 2.89 0 012.31-4.64 2.93 2.93 0 01.88.13V9.4a6.84 6.84 0 00-1-.05A6.33 6.33 0 005 20.1a6.34 6.34 0 0010.86-4.43v-7a8.16 8.16 0 004.77 1.52v-3.4a4.85 4.85 0 01-1-.1z"/></svg>
            </a>
            <a href="https://youtube.com/@luca.fb_ski" target="_blank" rel="noopener noreferrer" class="w-10 h-10 flex items-center justify-center border border-white/15 hover:border-white/40 hover:bg-white/5 transition-all" aria-label="YouTube">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M23 9.71a8.5 8.5 0 00-.91-4.13 2.92 2.92 0 00-1.72-1A78.36 78.36 0 0012 4.27a78.45 78.45 0 00-8.34.3 2.87 2.87 0 00-1.46.74c-.9.83-1 2.25-1.1 3.45a48.29 48.29 0 000 6.48 9.55 9.55 0 00.3 2 3.14 3.14 0 00.71 1.36 2.86 2.86 0 001.49.78 45.18 45.18 0 006.33.33 78.69 78.69 0 009.44-.33 2.84 2.84 0 001.49-.78 3.36 3.36 0 00.71-1.36 8.83 8.83 0 00.33-2.54c.01-1.75.06-3.5.12-5.25zM9.74 14.85V8.66l5.92 3.11c-1.66.92-3.28 1.83-5.92 3.08z"/></svg>
            </a>
            <a href="https://strava.com/athletes/luca.fb_ski" target="_blank" rel="noopener noreferrer" class="w-10 h-10 flex items-center justify-center border border-white/15 hover:border-white/40 hover:bg-white/5 transition-all" aria-label="Strava">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M15.387 17.944l-2.089-4.116h-3.065L15.387 24l5.15-10.172h-3.066m-7.008-5.599l2.836 5.598h4.172L10.463 0l-7 13.828h4.169"/></svg>
            </a>
          </div>
        </div>
      </div>
    </section>











  </main>
  <footer class="border-t border-white/[0.08] py-10">
    <div class="mx-auto max-w-[1440px] px-6 lg:px-12 flex flex-col lg:flex-row items-center justify-between gap-6">
      <p class="font-[family-name:var(--font-display)] tracking-[0.42em] uppercase">LUCA<span class="text-red-500">.</span>FB</p>
      <p class="text-sm text-white/40">© <span id="year"></span> Luca Finnis-Bernard</p>
    </div>
  </footer>
  <script is:inline>document.getElementById('year').textContent = new Date().getFullYear();</script>
</BaseLayout>
