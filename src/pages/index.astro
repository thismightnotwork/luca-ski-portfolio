---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Luca Finnis-Bernard — Ski, Design, Code" description="Alpine skiing portfolio and creative work.">
  <section class="mx-auto max-w-7xl px-6 pt-16 pb-24 md:pt-32 md:pb-40">
    <div class="max-w-4xl">
      <p class="text-sm uppercase tracking-[0.4em] text-white/50 mb-8">Ski • Design • Code</p>
      <h1 class="text-6xl md:text-8xl lg:text-9xl font-extrabold tracking-tight leading-[0.9]">
        Lines drawn<br />in snow &amp; pixels
      </h1>
      <p class="mt-8 text-lg md:text-xl text-white/70 max-w-2xl leading-relaxed">
        Freeride skier and builder crafting fast, considered digital experiences.
      </p>
      <div class="mt-12 flex flex-wrap gap-4">
        <a href="#work" class="px-8 py-4 rounded-full bg-white text-black text-sm font-medium hover:opacity-90 transition-opacity">View selected work</a>
        <a href="/about" class="px-8 py-4 rounded-full border border-white/20 text-sm hover:bg-white/5 transition-colors">About</a>
      </div>
    </div>
  </section>

  <section id="work" class="mx-auto max-w-7xl px-6 pb-24 md:pb-32">
    <div class="flex items-end justify-between mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight">Selected work</h2>
      <a href="/projects" class="text-sm text-white/50 hover:text-white transition-colors">View all →</a>
    </div>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <a href="/projects" class="group relative overflow-hidden rounded-3xl border border-white/10 aspect-[16/10]">
        <img src="https://images.unsplash.com/photo-1469474968028-56623f02e42e?q=80&w=2400&auto=format&fit=crop" alt="Alpine peak" class="absolute inset-0 h-full w-full object-cover transition-transform duration-1000 group-hover:scale-105" />
        <div class="absolute inset-0 bg-gradient-to-t from-black via-black/20 to-transparent"></div>
        <div class="absolute inset-x-0 bottom-0 p-8 md:p-10">
          <p class="text-xs uppercase tracking-[0.3em] text-white/50 mb-3">Alpine</p>
          <h3 class="text-2xl md:text-3xl font-semibold tracking-tight">Lines &amp; Terrain</h3>
          <p class="mt-2 text-white/70">Freeride documentation and route exploration</p>
        </div>
      </a>
      <a href="/projects" class="group relative overflow-hidden rounded-3xl border border-white/10 aspect-[16/10]">
        <img src="https://images.unsplash.com/photo-1555066931-4365d14bab8c?q=80&w=2400&auto=format&fit=crop" alt="Code editor" class="absolute inset-0 h-full w-full object-cover transition-transform duration-1000 group-hover:scale-105" />
        <div class="absolute inset-0 bg-gradient-to-t from-black via-black/20 to-transparent"></div>
        <div class="absolute inset-x-0 bottom-0 p-8 md:p-10">
          <p class="text-xs uppercase tracking-[0.3em] text-white/50 mb-3">Digital</p>
          <h3 class="text-2xl md:text-3xl font-semibold tracking-tight">Tools &amp; Interfaces</h3>
          <p class="mt-2 text-white/70">Thoughtful software and experiments</p>
        </div>
      </a>
    </div>
  </section>

  <section id="contact" class="mx-auto max-w-7xl px-6 pb-16">
    <div class="relative overflow-hidden rounded-3xl border border-white/10">
      <img src="https://images.unsplash.com/photo-1483728642387-6c3bdd6c93e5?q=80&w=2400&auto=format&fit=crop" alt="Mountain range at dusk" class="absolute inset-0 h-full w-full object-cover opacity-40" />
      <div class="absolute inset-0 bg-gradient-to-br from-black via-black/80 to-black"></div>
      <div class="relative p-10 md:p-16">
        <div class="max-w-2xl">
          <p class="text-xs uppercase tracking-[0.3em] text-white/50 mb-6">Contact</p>
          <h2 class="text-3xl md:text-5xl font-bold tracking-tight">Let's create something intentional</h2>
          <p class="mt-4 text-lg text-white/70">For collaborations, projects, or a chat about lines.</p>
          <a href="mailto:hello@lucafinnisbernard.com" class="mt-10 inline-block px-8 py-4 rounded-full bg-white text-black text-sm font-medium hover:opacity-90 transition-opacity">Get in touch</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
