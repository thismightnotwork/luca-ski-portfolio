---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import ProgressBar from '../components/ProgressBar.astro';
---
<BaseLayout title="Gallery — Luca Finnis-Bernard" description="Photos from the hill.">
  <ProgressBar />
  <Navigation />
  <main class="pt-36 pb-24">
    <section class="relative">
      <div class="mx-auto max-w-[1440px] px-6 lg:px-12">
        <div class="max-w-4xl mb-16">
          <div class="flex items-center gap-3 mb-8">
            <div class="flex gap-1.5">
              <span class="w-2.5 h-4 border-2 border-red-500 [clip-path:polygon(0_0,100%_25%,100%_75%,0_100%)]"></span>
              <span class="w-2.5 h-4 border-2 border-blue-500 [clip-path:polygon(0_0,100%_25%,100%_75%,0_100%)] -ml-1.5"></span>
            </div>
            <span class="text-[10px] font-mono uppercase tracking-[0.28em] text-white/40">Gallery</span>
          </div>
          <h1 class="font-[family-name:var(--font-display)] uppercase leading-[0.92]">On The Hill.</h1>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-3" id="gallery-grid"></div>
      </div>
    </section>
  </main>
  <footer class="border-t border-white/[0.08] py-10">
    <div class="mx-auto max-w-[1440px] px-6 lg:px-12 flex flex-col lg:flex-row items-center justify-between gap-6">
      <p class="font-[family-name:var(--font-display)] tracking-[0.42em] uppercase">LUCA<span class="text-red-500">.</span>FB</p>
      <p class="text-sm text-white/40">© <span id="year"></span> Luca Finnis-Bernard</p>
    </div>
  </footer>
  <div class="fixed inset-0 bg-black/95 hidden items-center justify-center z-[1100]" id="lightbox">
    <button class="absolute top-6 right-6 w-12 h-12 border border-white/15 flex items-center justify-center" id="lb-close">×</button>
    <button class="absolute left-6 top-1/2 -translate-y-1/2 w-12 h-12 border border-white/15 flex items-center justify-center" id="lb-prev">←</button>
    <button class="absolute right-6 top-1/2 -translate-y-1/2 w-12 h-12 border border-white/15 flex items-center justify-center" id="lb-next">→</button>
    <div class="max-w-5xl px-6">
      <img src="" alt="" class="max-h-[80vh] mx-auto" id="lb-img" />
      <p class="text-center mt-4 text-sm text-white/50" id="lb-cap"></p>
    </div>
  </div>
  <script is:inline src="/data.js"></script>
  <script is:inline src="/app.js"></script>
  <script is:inline>document.getElementById('year').textContent = new Date().getFullYear();</script>
</BaseLayout>
