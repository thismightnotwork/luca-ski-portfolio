---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="About — Luca Finnis-Bernard" description="About Luca Finnis-Bernard.">
  <section class="mx-auto max-w-4xl px-6 py-16 md:py-24">
    <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight">About</h1>
    <div class="mt-8 space-y-6 text-lg text-white/80 leading-relaxed">
      <p>
        I'm Luca Finnis-Bernard — skier, builder, and creative. This portfolio is a space for alpine pursuits and technical work.
      </p>
      <p>
        I care about clean lines, precision, and building things that feel intentional.
      </p>
    </div>
    <div class="mt-10">
      <a href="/" class="text-sm text-white/70 hover:text-white">← Back home</a>
    </div>
  </section>
</BaseLayout>
