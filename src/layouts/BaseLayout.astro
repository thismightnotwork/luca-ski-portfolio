---
import '../styles/global.css';
const { title = "Luca Finnis-Bernard | Alpine Ski Racer & BASI Level 2 Instructor", description = "British U18 alpine ski racer, BASI Ski UK Level 2 instructor and Snow Shepherd Pro Deal athlete racing for Hemel Ski Race Club." } = Astro.props;
---
<!DOCTYPE html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#050607" />
    <link rel="canonical" href="https://lucafinnisbernard.co.uk/" />
    
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://lucafinnisbernard.co.uk/" />
    <meta property="og:image" content="https://lucafinnisbernard.co.uk/photos/Tignes.jpeg" />
    
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://lucafinnisbernard.co.uk/photos/Tignes.jpeg" />
    
    <link rel="icon" type="image/png" href="/photos/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/photos/favicon.svg" />
    <link rel="shortcut icon" href="/photos/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/photos/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Luca F-B" />
    <link rel="manifest" href="/photos/site.webmanifest" />
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Archivo:wght@300;400;500;600;700;800;900&family=IBM+Plex+Mono:wght@400;500;600&family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Luca Finnis-Bernard",
      "nationality": "United Kingdom",
      "url": "https://lucafinnisbernard.co.uk/",
      "email": "mailto:contact@lucafinnisbernard.co.uk",
      "jobTitle": "Alpine ski racer and BASI Ski UK Level 2 instructor",
      "description": "British U18 alpine ski racer, BASI Ski UK Level 2 instructor and Snow Shepherd Pro Deal athlete racing slalom and giant slalom for Hemel Ski Race Club.",
      "memberOf": [{ "@type": "SportsOrganization", "name": "Hemel Ski Race Club" }],
      "sameAs": [
        "https://instagram.com/luca.fb_ski",
        "https://tiktok.com/@luca.fb_ski",
        "https://youtube.com/@luca.fb_ski",
        "https://facebook.com/luca.fb_ski",
        "https://strava.com/athletes/luca.fb_ski",
        "https://gbski.com/biography.php?id=42382"
      ]
    })}></script>
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[9999] focus:bg-white focus:text-black focus:px-6 focus:py-3 focus:text-sm focus:font-bold focus:tracking-[0.12em] focus:uppercase">Skip to content</a>
    <slot />
  </body>
</html>
