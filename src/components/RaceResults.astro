<section class="relative py-24 lg:py-36 border-t border-white/[0.08]" id="skiing">
  <div class="mx-auto max-w-[1440px] px-6 lg:px-12">
    <div class="max-w-4xl mb-16 lg:mb-20">
      <div class="flex items-center gap-3 mb-8">
        <div class="flex gap-1.5">
          <span class="w-2.5 h-4 border-2 border-red-500 [clip-path:polygon(0_0,100%_25%,100%_75%,0_100%)]"></span>
          <span class="w-2.5 h-4 border-2 border-blue-500 [clip-path:polygon(0_0,100%_25%,100%_75%,0_100%)] -ml-1.5"></span>
        </div>
        <span class="text-[10px] font-mono uppercase tracking-[0.28em] text-white/40">Race Record</span>
      </div>
      <h2 class="font-[family-name:var(--font-display)] uppercase leading-[0.92] mb-6">Results.</h2>
      <p class="text-lg text-white/70 leading-relaxed">18 recorded results across slalom, giant slalom and combined events. Sourced from <a href="https://gbski.com/biography.php?id=42382" target="_blank" rel="noopener noreferrer" class="underline underline-offset-4 hover:text-white">GBSki</a>.</p>
    </div>

    <div class="relative mb-16 border border-white/[0.08] overflow-hidden">
      <div class="absolute top-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-red-500/40 to-transparent"></div>
      <div class="bg-gradient-to-b from-white/[0.015] to-transparent p-8 lg:p-12">
        <p class="text-[10px] font-mono uppercase tracking-[0.28em] text-white/40 mb-10">Career highlights</p>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-10">
          <div class="relative pt-5"><div class="absolute top-0 left-0 w-8 h-px bg-gradient-to-r from-red-500 to-blue-500"></div><div class="text-5xl lg:text-6xl font-[family-name:var(--font-heading)] font-black tracking-tight">1</div><div class="mt-3 text-[10px] font-mono uppercase tracking-[0.22em] text-white/40">Win</div></div>
          <div class="relative pt-5"><div class="absolute top-0 left-0 w-8 h-px bg-gradient-to-r from-red-500 to-blue-500"></div><div class="text-5xl lg:text-6xl font-[family-name:var(--font-heading)] font-black tracking-tight">7</div><div class="mt-3 text-[10px] font-mono uppercase tracking-[0.22em] text-white/40">Podiums</div></div>
          <div class="relative pt-5"><div class="absolute top-0 left-0 w-8 h-px bg-gradient-to-r from-red-500 to-blue-500"></div><div class="text-5xl lg:text-6xl font-[family-name:var(--font-heading)] font-black tracking-tight">11</div><div class="mt-3 text-[10px] font-mono uppercase tracking-[0.22em] text-white/40">Top 10</div></div>
          <div class="relative pt-5"><div class="absolute top-0 left-0 w-8 h-px bg-gradient-to-r from-red-500 to-blue-500"></div><div class="text-5xl lg:text-6xl font-[family-name:var(--font-heading)] font-black tracking-tight">18</div><div class="mt-3 text-[10px] font-mono uppercase tracking-[0.22em] text-white/40">Results</div></div>
        </div>
      </div>
    </div>

    <div class="border border-white/[0.08]">
      <div class="flex items-center justify-between p-6 lg:p-8 border-b border-white/[0.08]">
        <div>
          <h3 class="text-xl lg:text-2xl font-[family-name:var(--font-heading)] font-bold mb-1">Full Results</h3>
          <p class="text-sm text-white/40">All recorded races</p>
        </div>
        <div class="hidden md:flex items-center gap-2 text-[10px] font-mono uppercase tracking-[0.22em] text-white/40">
          <span class="w-2 h-2 bg-red-500"></span> SL
          <span class="w-2 h-2 bg-blue-500 ml-4"></span> GS
        </div>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full min-w-[1000px]">
          <thead>
            <tr class="border-b border-white/[0.08]">
              <th class="text-left text-[10px] font-mono uppercase tracking-[0.22em] text-white/40 px-6 lg:px-8 py-4">Date</th>
              <th class="text-left text-[10px] font-mono uppercase tracking-[0.22em] text-white/40 px-6 lg:px-8 py-4">Event</th>
              <th class="text-left text-[10px] font-mono uppercase tracking-[0.22em] text-white/40 px-6 lg:px-8 py-4">Venue</th>
              <th class="text-left text-[10px] font-mono uppercase tracking-[0.22em] text-white/40 px-6 lg:px-8 py-4">Discipline</th>
              <th class="text-left text-[10px] font-mono uppercase tracking-[0.22em] text-white/40 px-6 lg:px-8 py-4">Category</th>
              <th class="text-left text-[10px] font-mono uppercase tracking-[0.22em] text-white/40 px-6 lg:px-8 py-4">Place</th>
              <th class="text-left text-[10px] font-mono uppercase tracking-[0.22em] text-white/40 px-6 lg:px-8 py-4">Time</th>
            </tr>
          </thead>
          <tbody id="race-table-body"></tbody>
        </table>
      </div>
    </div>
  </div>
</section>

<script is:inline>
(async function(){
  const body = document.getElementById('race-table-body');
  if(!body) return;
  try {
    const res = await fetch('/data/gbski.json?v=' + Date.now());
    const data = await res.json();
    const races = (data.races || []).slice().sort((a,b) => b.date.localeCompare(a.date));
    races.forEach(r => {
      const tr = document.createElement('tr');
      tr.className = 'border-b border-white/[0.06] hover:bg-white/[0.01] transition-colors';
      const disc = (r.discipline || '').toUpperCase();
      const dot = disc.includes('SL') && !disc.includes('GS') ? 'bg-red-500' : disc.includes('GS') ? 'bg-blue-500' : 'bg-white/40';
      tr.innerHTML = `
        <td class="px-6 lg:px-8 py-5 text-sm tabular-nums text-white/70">${r.date || ''}</td>
        <td class="px-6 lg:px-8 py-5"><div class="font-medium">${r.event || ''}</div></td>
        <td class="px-6 lg:px-8 py-5 text-sm text-white/60">${r.venue || ''}</td>
        <td class="px-6 lg:px-8 py-5"><div class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full ${dot}"></span><span class="text-sm">${r.discipline || '-'}</span></div></td>
        <td class="px-6 lg:px-8 py-5 text-sm text-white/60">${r.category || '-'}</td>
        <td class="px-6 lg:px-8 py-5"><span class="font-semibold">${r.place || '-'}</span></td>
        <td class="px-6 lg:px-8 py-5 text-sm tabular-nums text-white/60">${r.time || (r.times && r.times[0]) || '-'}</td>
      `;
      body.appendChild(tr);
    });
  } catch(e) {}
})();
</script>
