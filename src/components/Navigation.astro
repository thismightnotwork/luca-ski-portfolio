<header class="fixed top-0 inset-x-0 z-[900]" id="site-header">
  <div class="mx-auto max-w-[1440px] px-6 lg:px-12">
    <div class="flex items-center justify-between gap-8 py-6 transition-all duration-700" id="header-inner">
      <a href="/" class="flex items-center gap-3 group">
        <div class="relative">
          <span class="font-[family-name:var(--font-display)] text-base lg:text-lg tracking-[0.42em] uppercase">LUCA<span class="text-red-500">.</span>FB</span>
        </div>
      </a>
      
      <nav class="hidden lg:flex items-center gap-1">
        <a href="/" class="relative px-5 py-2.5 text-xs font-semibold tracking-[0.18em] uppercase text-white/60 hover:text-white transition-colors group">
          <span class="relative z-10">About</span>
          <span class="absolute inset-0 bg-white/[0.02] opacity-0 group-hover:opacity-100 transition-opacity"></span>
        </a>
        <a href="/skiing" class="relative px-5 py-2.5 text-xs font-semibold tracking-[0.18em] uppercase text-white/60 hover:text-white transition-colors group">
          <span class="relative z-10">Skiing</span>
          <span class="absolute inset-0 bg-white/[0.02] opacity-0 group-hover:opacity-100 transition-opacity"></span>
        </a>
        <a href="/results" class="relative px-5 py-2.5 text-xs font-semibold tracking-[0.18em] uppercase text-white/60 hover:text-white transition-colors group">
          <span class="relative z-10">Results</span>
          <span class="absolute inset-0 bg-white/[0.02] opacity-0 group-hover:opacity-100 transition-opacity"></span>
        </a>
        <a href="/journey" class="relative px-5 py-2.5 text-xs font-semibold tracking-[0.18em] uppercase text-white/60 hover:text-white transition-colors group">
          <span class="relative z-10">Journey</span>
          <span class="absolute inset-0 bg-white/[0.02] opacity-0 group-hover:opacity-100 transition-opacity"></span>
        </a>
        <a href="/gallery" class="relative px-5 py-2.5 text-xs font-semibold tracking-[0.18em] uppercase text-white/60 hover:text-white transition-colors group">
          <span class="relative z-10">Gallery</span>
          <span class="absolute inset-0 bg-white/[0.02] opacity-0 group-hover:opacity-100 transition-opacity"></span>
        </a>
        <a href="/contact" class="relative px-5 py-2.5 text-xs font-semibold tracking-[0.18em] uppercase text-white/60 hover:text-white transition-colors group">
          <span class="relative z-10">Contact</span>
          <span class="absolute inset-0 bg-white/[0.02] opacity-0 group-hover:opacity-100 transition-opacity"></span>
        </a>
      </nav>
      
      <div class="flex items-center gap-4">
        <a href="/contact" class="hidden md:inline-flex items-center gap-3 px-7 py-3 text-[10px] font-bold tracking-[0.24em] uppercase border border-white/15 hover:border-white/40 transition-all duration-500 group relative overflow-hidden">
          <span class="relative z-10">Get in touch</span>
          <svg class="relative z-10 w-4 h-4 group-hover:translate-x-1 transition-transform" viewBox="0 0 16 16" fill="none"><path d="M6 3L11 8L6 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span class="absolute inset-0 bg-gradient-to-r from-red-500/10 to-blue-500/10 translate-y-full group-hover:translate-y-0 transition-transform duration-500"></span>
        </a>
        <button class="lg:hidden w-12 h-12 flex flex-col items-center justify-center gap-1.5 border border-white/15" id="menu-btn" aria-label="Open navigation">
          <span class="w-5 h-px bg-white"></span>
          <span class="w-5 h-px bg-white"></span>
          <span class="w-5 h-px bg-white"></span>
        </button>
      </div>
    </div>
  </div>
  <div class="absolute inset-x-0 bottom-0 h-px bg-gradient-to-r from-transparent via-white/10 to-transparent"></div>
</header>

<div class="fixed inset-0 z-[1000] hidden" id="mobile-nav">
  <div class="absolute inset-0 bg-black/95 backdrop-blur-2xl"></div>
  <button class="absolute top-6 right-6 w-12 h-12 flex items-center justify-center border border-white/15 text-white" id="menu-close" aria-label="Close navigation">
    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 6L6 18M6 6l12 12"/></svg>
  </button>
  <nav class="relative h-full flex flex-col items-center justify-center gap-6">
    <a href="/" class="text-4xl md:text-5xl font-[family-name:var(--font-heading)] font-bold tracking-tight hover:text-white/60 transition-colors">About</a>
    <a href="/skiing" class="text-4xl md:text-5xl font-[family-name:var(--font-heading)] font-bold tracking-tight hover:text-white/60 transition-colors">Skiing</a>
    <a href="/results" class="text-4xl md:text-5xl font-[family-name:var(--font-heading)] font-bold tracking-tight hover:text-white/60 transition-colors">Results</a>
    <a href="/journey" class="text-4xl md:text-5xl font-[family-name:var(--font-heading)] font-bold tracking-tight hover:text-white/60 transition-colors">Journey</a>
    <a href="/gallery" class="text-4xl md:text-5xl font-[family-name:var(--font-heading)] font-bold tracking-tight hover:text-white/60 transition-colors">Gallery</a>
    <a href="/contact" class="text-4xl md:text-5xl font-[family-name:var(--font-heading)] font-bold tracking-tight hover:text-white/60 transition-colors">Contact</a>
  </nav>
</div>

<script is:inline>
(function(){
  const header = document.getElementById('site-header');
  const inner = document.getElementById('header-inner');
  const btn = document.getElementById('menu-btn');
  const close = document.getElementById('menu-close');
  const nav = document.getElementById('mobile-nav');
  const links = nav ? nav.querySelectorAll('a') : [];
  
  function onScroll(){
    if(window.scrollY > 50){
      header.classList.add('bg-black/70','backdrop-blur-xl');
      inner.classList.add('py-4');
      inner.classList.remove('py-6');
    }else{
      header.classList.remove('bg-black/70','backdrop-blur-xl');
      inner.classList.remove('py-4');
      inner.classList.add('py-6');
    }
  }
  window.addEventListener('scroll', onScroll, {passive:true});
  onScroll();
  
  function open(){
    if(!nav) return;
    nav.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }
  function shut(){
    if(!nav) return;
    nav.classList.add('hidden');
    document.body.style.overflow = '';
  }
  if(btn) btn.addEventListener('click', open);
  if(close) close.addEventListener('click', shut);
  links.forEach(a => a.addEventListener('click', shut));
  document.addEventListener('keydown', e => { if(e.key === 'Escape') shut(); });
})();
</script>
