{
  "name": "eccentric-earth",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "fetch:instagram": "node scripts/fetch-instagram-3rdparty.mjs || node scripts/fetch-instagram-stats-apify.mjs || true",
    "fetch:tiktok": "node scripts/fetch-tiktok-display.mjs || node scripts/fetch-tiktok-stats.mjs || true",
