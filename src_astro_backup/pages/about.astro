---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="About — Luca Finnis-Bernard" description="About Luca Finnis-Bernard.">
  <section class="mx-auto max-w-4xl px-6 pt-16 pb-32 md:pt-32">
    <p class="text-sm uppercase tracking-[0.4em] text-white/50 mb-8">About</p>
    <h1 class="text-5xl md:text-7xl font-extrabold tracking-tight leading-[0.95]">Precision on snow. Clarity in code.</h1>
    <div class="mt-12 space-y-8 text-lg text-white/75 leading-relaxed">
      <p>I'm Luca Finnis-Bernard — a freeride skier and builder who finds beauty in clean lines, considered details, and things that just work.</p>
      <p>This space brings together alpine pursuits and digital work.</p>
    </div>
    <div class="mt-16 flex flex-wrap gap-4">
      <a href="/" class="text-sm text-white/60 hover:text-white transition-colors">← Back home</a>
      <a href="/projects" class="text-sm text-white/60 hover:text-white transition-colors">View projects →</a>
    </div>
  </section>
</BaseLayout>
